    that someone can be my uncle.","parentUIDs":[3],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":203.333344,"yPos":22},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"The

  CurrentIDCounter: 14
  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":10}],"EditorInfo":{"isRoot":false,"xPos":139.333374,"yPos":106.999573},"ID":7,"ParamActions":[],"TMPFontGUID":null,"Text":"Yeah,
    all done.","parentUIDs":[5],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":9}],"EditorInfo":{"isRoot":false,"xPos":360.000031,"yPos":105.6661},"ID":8,"ParamActions":[],"TMPFontGUID":null,"Text":"Uhh...
    yeah. totally. for sure. Don''t worry about it, man. ","parentUIDs":[5],"SpeechUID":-1},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":146.666656,"yPos":377.664764},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"Go
    and slack off!","parentUIDs":[11],"SpeechUID":-1},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":400.666656,"yPos":382.3315},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"Go
    and really get into it!","parentUIDs":[11],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":220.666656,"yPos":-516.0002},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Ah,
    you''re here. You know the drill, get the fishing rod and get to the pier. We
    can''t be going low on inventory now.","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":2}],"EditorInfo":{"isRoot":false,"xPos":223.666687,"yPos":-410.000031},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"...Do
    I really have to? We got so much stuff...","parentUIDs":[0],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":3}],"EditorInfo":{"isRoot":false,"xPos":223.999969,"yPos":-304.666962},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"Don''t
    be slacking off now! You should be grateful I''m giving you a real job!","parentUIDs":[1],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":4}],"EditorInfo":{"isRoot":false,"xPos":224.666687,"yPos":-195.333557},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"That''s
    the problem with you kids, you don''t want to work a day in your lives!","parentUIDs":[2],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":5}],"EditorInfo":{"isRoot":false,"xPos":226,"yPos":-94.66684},"ID":4,"ParamActions":[],"TMPFontGUID":null,"Text":"Okay,
    okay, I got it! No need to get so worked up, I''ll get it done...","parentUIDs":[3],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":7},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":230.666718,"yPos":15.3327637},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"That''s
    right, you will. Are you all done in the shop?","parentUIDs":[4],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":11}],"EditorInfo":{"isRoot":false,"xPos":360.666656,"yPos":175.3328},"ID":9,"ParamActions":[],"TMPFontGUID":null,"Text":"Oh,
    so you didn''t. Get outta here! You''re far more useful catching fish than hanging
    out in the store.","parentUIDs":[8],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":11}],"EditorInfo":{"isRoot":false,"xPos":137.333344,"yPos":176.6661},"ID":10,"ParamActions":[],"TMPFontGUID":null,"Text":"Ah.
    Great. Ahem... Thanks. Go catch that fish now!","parentUIDs":[7],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":12},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":false,"xPos":271.333344,"yPos":293.999481},"ID":11,"ParamActions":[],"TMPFontGUID":null,"Text":"Ugh...","parentUIDs":[9,10],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
